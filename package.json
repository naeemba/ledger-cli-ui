{
  "name": "ledger-cli-ui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "app:dev": "./scripts/app-dev.sh",
    "app:down": "docker compose down",
    "app:reset": "docker compose down -v",
    "migrate": "next-starter migrate && drizzle-kit migrate",
    "predev": "dotenv -e .env -- pnpm migrate",
    "dev": "dotenv -e .env -- next dev",
    "prebuild": "pnpm migrate",
    "build": "next build",
    "prestart": "pnpm migrate",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shadcn:add": "f() { shadcn add -y \"$@\" && prettier --write 'components/ui/**/*.{ts,tsx}'; }; f",
    "db:generate": "drizzle-kit generate",
    "db:migrate:auth": "next-starter migrate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@base-ui/react": "^1.7.0",
    "@better-auth/passkey": "^1.7.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@heroicons/react": "^2.2.0",
    "@lezer/highlight": "^1.2.3",
    "@naeemba/next-starter": "^0.11.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.72.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@uiw/react-codemirror": "^4.25.11",
    "adm-zip": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.38.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.10.1",
    "resend": "^6.25.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.20.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "commitlint": "^21.2.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.4"
}
