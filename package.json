{
  "name": "ledger-cli-ui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "app:dev": "./scripts/app-dev.sh",
    "app:down": "docker compose down",
    "app:reset": "docker compose down -v",
    "migrate": "next-starter migrate && drizzle-kit migrate",
    "predev": "dotenv -e .env -- pnpm migrate",
    "dev": "dotenv -e .env -- next dev",
    "prebuild": "pnpm migrate",
    "build": "next build",
    "prestart": "pnpm migrate",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "shadcn:add": "f() { shadcn add -y \"$@\" && prettier --write 'components/ui/**/*.{ts,tsx}'; }; f",
    "db:generate": "drizzle-kit generate",
    "db:migrate:auth": "next-starter migrate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "^1.7.15",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@heroicons/react": "^2.2.0",
    "@lezer/highlight": "^1.2.5",
    "@naeemba/next-starter": "^0.13.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@sentry/nextjs": "^11.10.0",
    "@tanstack/react-virtual": "^3.14.25",
    "@uiw/react-codemirror": "^4.25.12",
    "adm-zip": "^0.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.10.1",
    "resend": "^6.37.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "commitlint": "^21.2.4",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2 <2.1.7": "^2.1.7",
      "brace-expansion@>=4 <5.0.12": "^5.0.12",
      "minimatch@>=9 <11.0.1": "^11.0.1",
      "glob@>=9 <14.0.2": "^14.0.2",
      "esbuild@<0.25.0": "^0.25.12"
    }
  }
}
